{
    "name": "webdna/query-boost",
    "description": "Craft 6's element query speed-ups for Craft 5: composite indexes and an index-friendly sort tiebreaker",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "performance",
        "element queries"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "webdna",
            "homepage": "https://webdna.co.uk"
        }
    ],
    "support": {
        "docs": "https://github.com/webdna/craft-query-boost/blob/main/README.md",
        "issues": "https://github.com/webdna/craft-query-boost/issues",
        "source": "https://github.com/webdna/craft-query-boost"
    },
    "require": {
        "craftcms/cms": "^5.0",
        "php": "^8.2"
    },
    "require-dev": {
        "codeception/codeception": "^5.2",
        "codeception/module-asserts": "^3.0",
        "codeception/module-yii2": "^1.1",
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "webdna\\queryboost\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "webdna\\queryboost\\tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs",
            "@analyse",
            "@test:unit",
            "@test:integration"
        ],
        "cs": "ecs check --ansi",
        "cs-fix": "ecs check --ansi --fix",
        "analyse": [
            "codecept build --quiet",
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "test:unit": "codecept run unit",
        "test:integration": "codecept run integration"
    },
    "extra": {
        "name": "Query Boost",
        "handle": "query-boost",
        "hasCpSettings": false,
        "hasCpSection": false,
        "changelogUrl": "https://raw.githubusercontent.com/webdna/craft-query-boost/main/CHANGELOG.md",
        "class": "webdna\\queryboost\\QueryBoost"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "php-http/discovery": false,
            "yiisoft/yii2-composer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
